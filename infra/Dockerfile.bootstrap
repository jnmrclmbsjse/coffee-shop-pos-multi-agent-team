# One-time bootstrap environment for `pulumi up` — see DEPLOYMENT.md §5a.
# Not part of the app or the ongoing deploy pipeline; used once, then
# discarded (`docker run --rm`). Replaces the AWS CloudShell approach, which
# hit that environment's small persistent-storage quota.
FROM node:24-bookworm

RUN apt-get update && \
    apt-get install -y --no-install-recommends python3-pip curl ca-certificates && \
    pip3 install --no-cache-dir --break-system-packages awscli && \
    curl -fsSL https://get.pulumi.com | sh && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

ENV PATH="/root/.pulumi/bin:${PATH}"
WORKDIR /workspace
