# Production environment reference for the single-EC2 deployment.
#
# This file contains placeholders only. It is never copied directly to EC2 and
# must never contain production credentials.
#
# The deployment script reads individual SecureString values from:
#
#   /coffee-shop-pos/prod/
#
# It then renders two files:
#
#   /opt/coffee-shop-pos/.env
#       Docker Compose interpolation and PostgreSQL configuration
#
#   /opt/coffee-shop-pos/deploy/api.env
#       Long-running API runtime configuration
#
# See infra/DEPLOYMENT.md §3.

# ---------------------------------------------------------------------------
# /opt/coffee-shop-pos/.env
# ---------------------------------------------------------------------------

# Set by deploy.yml to the immutable private ECR image tagged with the Git SHA.
API_IMAGE="851438481274.dkr.ecr.ap-southeast-1.amazonaws.com/coffee-shop-pos-api:REPLACE_WITH_40_CHARACTER_GIT_SHA"

POSTGRES_USER="coffee_shop_pos"
POSTGRES_PASSWORD="replace-with-a-strong-password"
POSTGRES_DB="coffee_shop_pos"

# ---------------------------------------------------------------------------
# /opt/coffee-shop-pos/deploy/api.env
# ---------------------------------------------------------------------------

# The hostname must remain `db`, which is the PostgreSQL Compose service name.
DATABASE_URL="postgresql://coffee_shop_pos:replace-with-a-strong-password@db:5432/coffee_shop_pos?schema=public"

API_PORT="3000"
WEB_ORIGIN="https://d303xx41l50p1t.cloudfront.net"

JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"

# Secure cookies are required in production. Do not set
# AUTH_COOKIE_SECURE=false.
AUTH_COOKIE_SAME_SITE="lax"

AUTH_THROTTLE_MAX_FAILURES="5"
AUTH_THROTTLE_COOLDOWN_SECONDS="30"

# ---------------------------------------------------------------------------
# Seed-only SSM parameters
# ---------------------------------------------------------------------------
#
# These values are not written into either long-running environment file.
# They are retrieved only when an explicit one-time seed operation is run.

SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="replace-before-seeding"
SEED_ADMIN_DISPLAY_NAME="Administrator"

SEED_STAFF_USERNAME="staff"
SEED_STAFF_PASSWORD="replace-before-seeding"
SEED_STAFF_DISPLAY_NAME="Coffee Shop Staff"
SEED_STAFF_PIN="replace-with-a-real-4-digit-pin"
