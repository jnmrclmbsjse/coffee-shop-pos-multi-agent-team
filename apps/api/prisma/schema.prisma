generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StockCountPhase {
  OPEN
  CLOSE
}

enum SaleKind {
  PURCHASE
  VOID
}

enum TradingDayStatus {
  OPEN
  CLOSED
}

enum PaymentMethod {
  CASH
  ONLINE
}

enum OrderStatus {
  PARKED
  COMPLETED
}

enum ServiceType {
  DINE_IN
  TAKE_OUT
}

enum LineDiscountKind {
  NONE
  SENIOR
}

enum Role {
  ADMIN
  STAFF
}

enum CountMethod {
  QUANTITY
  LEVEL
}

enum DayType {
  NORMAL
  PEAK
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique
  displayName  String   @map("display_name")
  passwordHash String   @map("password_hash")
  pinHash      String?  @map("pin_hash")
  isActive     Boolean  @default(true) @map("is_active")
  role         Role
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Location {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  createdAt    DateTime      @default(now()) @map("created_at")
  stockCounts  StockCount[]
  sales        Sale[]
  staffMembers StaffMember[]
  tradingDays  TradingDay[]

  @@map("locations")
}

model StaffMember {
  id                String       @id @default(uuid()) @db.Uuid
  displayName       String       @map("display_name")
  isActive          Boolean      @default(true) @map("is_active")
  locationId        String?      @map("location_id") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  location          Location?    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  openedTradingDays TradingDay[] @relation("TradingDayOpenedBy")
  closedTradingDays TradingDay[] @relation("TradingDayClosedBy")
  cashCounts        CashCount[]

  @@index([locationId])
  @@map("staff_members")
}

model Product {
  id         String           @id @default(uuid()) @db.Uuid
  sku        String           @unique
  name       String
  categoryId String           @map("category_id") @db.Uuid
  active     Boolean          @default(true)
  available  Boolean          @default(true)
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  category   Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants   ProductVariant[]

  @@index([categoryId])
  @@map("products")
}

model Category {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  sortWeight Int       @map("sort_weight")
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  products   Product[]

  @@index([sortWeight])
  @@map("categories")
}

model StockCategory {
  id         String          @id @default(uuid()) @db.Uuid
  name       String
  sortWeight Int             @map("sort_weight")
  active     Boolean         @default(true)
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")
  items      InventoryItem[]

  @@index([sortWeight])
  @@map("stock_categories")
}

model ProductVariant {
  id                 String         @id @default(uuid()) @db.Uuid
  productId          String         @map("product_id") @db.Uuid
  name               String
  priceCents         Int            @map("price_cents")
  sortWeight         Int            @map("sort_weight")
  active             Boolean        @default(true)
  cupInventoryItemId String?        @map("cup_inventory_item_id") @db.Uuid
  lidInventoryItemId String?        @map("lid_inventory_item_id") @db.Uuid
  product            Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  cupInventoryItem   InventoryItem? @relation("VariantCupInventoryItem", fields: [cupInventoryItemId], references: [id], onDelete: Restrict)
  lidInventoryItem   InventoryItem? @relation("VariantLidInventoryItem", fields: [lidInventoryItemId], references: [id], onDelete: Restrict)
  saleLines          SaleLine[]

  @@unique([productId, name])
  @@index([cupInventoryItemId])
  @@index([lidInventoryItemId])
  @@map("product_variants")
}

model InventoryItem {
  id                 String           @id @default(uuid()) @db.Uuid
  sku                String           @unique
  name               String
  categoryId         String           @map("category_id") @db.Uuid
  unit               String
  size               String?
  countMethod        CountMethod      @map("count_method")
  critical           Boolean          @default(false)
  reconciled         Boolean          @default(false)
  active             Boolean          @default(true)
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  category           StockCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  parLevels          ParLevel[]
  stockCountLines    StockCountLine[]
  cupProductVariants ProductVariant[] @relation("VariantCupInventoryItem")
  lidProductVariants ProductVariant[] @relation("VariantLidInventoryItem")

  @@index([categoryId])
  @@map("inventory_items")
}

// Par quantities are non-monetary whole stock units. Their ordering invariant
// (urgent <= low <= par) is enforced by both the API and database migration.
model ParLevel {
  id              String        @id @default(uuid()) @db.Uuid
  inventoryItemId String        @map("inventory_item_id") @db.Uuid
  dayType         DayType       @map("day_type")
  parQty          Int           @map("par_qty")
  lowThreshold    Int?          @map("low_threshold")
  urgentThreshold Int?          @map("urgent_threshold")
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@unique([inventoryItemId, dayType])
  @@map("par_levels")
}

// Append-only: corrections are additional StockCount records linked with
// correctsStockCountId. Application code must not update or delete records.
model StockCount {
  id                   String           @id @default(uuid()) @db.Uuid
  locationId           String?          @map("location_id") @db.Uuid
  businessDate         DateTime         @map("business_date") @db.Date
  phase                StockCountPhase
  recordedAt           DateTime         @default(now()) @map("recorded_at")
  recordedBy           String           @map("recorded_by")
  correctsStockCountId String?          @map("corrects_stock_count_id") @db.Uuid
  location             Location?        @relation(fields: [locationId], references: [id], onDelete: Restrict)
  corrects             StockCount?      @relation("StockCountCorrections", fields: [correctsStockCountId], references: [id], onDelete: Restrict)
  corrections          StockCount[]     @relation("StockCountCorrections")
  lines                StockCountLine[]

  @@index([locationId, businessDate, phase])
  @@map("stock_counts")
}

model StockCountLine {
  id              String        @id @default(uuid()) @db.Uuid
  stockCountId    String        @map("stock_count_id") @db.Uuid
  inventoryItemId String        @map("inventory_item_id") @db.Uuid
  quantity        Int
  stockCount      StockCount    @relation(fields: [stockCountId], references: [id], onDelete: Restrict)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@unique([stockCountId, inventoryItemId])
  @@map("stock_count_lines")
}

// The database migration adds a NULLS NOT DISTINCT partial unique index that
// permits at most one OPEN trading day per location, including the current
// nullable-location case. Prisma does not model partial indexes.
model TradingDay {
  id                    String           @id @default(uuid()) @db.Uuid
  locationId            String?          @map("location_id") @db.Uuid
  businessDate          DateTime         @map("business_date") @db.Date
  status                TradingDayStatus
  openedAt              DateTime         @map("opened_at")
  closedAt              DateTime?        @map("closed_at")
  openingFloatCents     Int              @map("opening_float_cents")
  openedByStaffMemberId String           @map("opened_by_staff_member_id") @db.Uuid
  closedByStaffMemberId String?          @map("closed_by_staff_member_id") @db.Uuid
  location              Location?        @relation(fields: [locationId], references: [id], onDelete: Restrict)
  openedByStaffMember   StaffMember      @relation("TradingDayOpenedBy", fields: [openedByStaffMemberId], references: [id], onDelete: Restrict)
  closedByStaffMember   StaffMember?     @relation("TradingDayClosedBy", fields: [closedByStaffMemberId], references: [id], onDelete: Restrict)
  cashCounts            CashCount[]
  cashExpenses          CashExpense[]
  sales                 Sale[]

  @@index([locationId, businessDate])
  @@map("trading_days")
}

// Append-only: corrections are additional CashCount records. The latest count
// is the actual cash value for a closed trading day.
model CashCount {
  id                     String      @id @default(uuid()) @db.Uuid
  tradingDayId           String      @map("trading_day_id") @db.Uuid
  countedCents           Int         @map("counted_cents")
  countedAt              DateTime    @default(now()) @map("counted_at")
  countedByStaffMemberId String      @map("counted_by_staff_member_id") @db.Uuid
  tradingDay             TradingDay  @relation(fields: [tradingDayId], references: [id], onDelete: Restrict)
  countedByStaffMember   StaffMember @relation(fields: [countedByStaffMemberId], references: [id], onDelete: Restrict)

  @@index([tradingDayId, countedAt])
  @@map("cash_counts")
}

// Append-only: expense corrections are recorded as new signed rows.
model CashExpense {
  id           String     @id @default(uuid()) @db.Uuid
  tradingDayId String     @map("trading_day_id") @db.Uuid
  amountCents  Int        @map("amount_cents")
  description  String
  recordedAt   DateTime   @default(now()) @map("recorded_at")
  tradingDay   TradingDay @relation(fields: [tradingDayId], references: [id], onDelete: Restrict)

  @@index([tradingDayId, recordedAt])
  @@map("cash_expenses")
}

// Append-only and idempotent: clientGeneratedId is supplied by the register
// and is globally unique. Voids are new records linked through correctsSaleId;
// application code must not update or delete an existing sale.
model Sale {
  id                String        @id @default(uuid()) @db.Uuid
  clientGeneratedId String        @unique @map("client_generated_id") @db.Uuid
  locationId        String?       @map("location_id") @db.Uuid
  tradingDayId      String        @map("trading_day_id") @db.Uuid
  kind              SaleKind      @default(PURCHASE)
  correctsSaleId    String?       @map("corrects_sale_id") @db.Uuid
  dayOrderNumber    Int           @map("day_order_number")
  status            OrderStatus
  customerName      String?       @map("customer_name")
  serviceType       ServiceType   @map("service_type")
  subtotalCents     Int           @map("subtotal_cents")
  discountCents     Int           @default(0) @map("discount_cents")
  taxCents          Int           @map("tax_cents")
  totalCents        Int           @map("total_cents")
  cashTipCents      Int           @default(0) @map("cash_tip_cents")
  cashReceivedCents Int?          @map("cash_received_cents")
  changeOwedCents   Int           @default(0) @map("change_owed_cents")
  changeSettledAt   DateTime?     @map("change_settled_at")
  completedAt       DateTime?     @map("completed_at")
  voidReason        String?       @map("void_reason")
  recordedAt        DateTime      @default(now()) @map("recorded_at")
  location          Location?     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  tradingDay        TradingDay    @relation(fields: [tradingDayId], references: [id], onDelete: Restrict)
  corrects          Sale?         @relation("SaleCorrections", fields: [correctsSaleId], references: [id], onDelete: Restrict)
  corrections       Sale[]        @relation("SaleCorrections")
  lines             SaleLine[]
  payments          SalePayment[]

  @@unique([tradingDayId, dayOrderNumber])
  @@index([locationId, recordedAt])
  @@index([tradingDayId])
  @@map("sales")
}

// Append-only: a split tender is represented by one row for each method.
model SalePayment {
  id          String        @id @default(uuid()) @db.Uuid
  saleId      String        @map("sale_id") @db.Uuid
  method      PaymentMethod
  amountCents Int           @map("amount_cents")
  sale        Sale          @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@unique([saleId, method])
  @@map("sale_payments")
}

model SaleLine {
  id                  String           @id @default(uuid()) @db.Uuid
  saleId              String           @map("sale_id") @db.Uuid
  productVariantId    String           @map("product_variant_id") @db.Uuid
  quantity            Int
  unitPriceCents      Int              @map("unit_price_cents")
  lineGrossCents      Int              @map("line_gross_cents")
  discountKind        LineDiscountKind @map("discount_kind")
  discountCents       Int              @default(0) @map("discount_cents")
  lineTotalCents      Int              @map("line_total_cents")
  productNameSnapshot String           @map("product_name_snapshot")
  variantNameSnapshot String           @map("variant_name_snapshot")
  sale                Sale             @relation(fields: [saleId], references: [id], onDelete: Restrict)
  productVariant      ProductVariant   @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@map("sale_lines")
}
